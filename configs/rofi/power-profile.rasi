/* ── CGGX Power Profile — Waybar Dropdown ─────── */

* {
  bg:      #0a0a0c;
  surface: #1a1a20;
  border:  #2a2a35;
  fg:      #e8e8f0;
  fg-dim:  #6a6a80;
}

window {
  background-color:   var(surface);
  text-color:         var(fg);
  border:             0 1px 1px 1px;
  border-color:       var(border);
  border-radius:      0;
  width:              220;
  padding:            0;
  font:               "MonaspiceNe Nerd Font Mono 13";
  location:           northeast;
  anchor:             northeast;
  y-offset:           50;
  x-offset:           -80;
}

mainbox {
  enabled:            true;
  spacing:            0;
  padding:            0;
}

listview {
  lines:              3;
  spacing:            0;
  padding:            0;
  dynamic:            false;
  scrollbar:          false;
  fixed-height:       true;
  layout:             vertical;
}

element {
  orientation:        horizontal;
  children:           [ element-text ];
  spacing:            0;
  padding:            9 14;
}

element normal.normal {
  background-color:   transparent;
}

element selected.normal {
  background-color:   rgba(255, 255, 255, 0.05);
}

element active.normal {
  background-color:   transparent;
}

element selected.active {
  background-color:   rgba(255, 255, 255, 0.07);
}

element-text {
  text-color:         inherit;
  vertical-align:     0.5;
  horizontal-align:   0;
  padding:            0;
  font:               "MonaspiceNe Nerd Font Mono 13";
}

inputbar { enabled: false; }
prompt  { enabled: false; }
