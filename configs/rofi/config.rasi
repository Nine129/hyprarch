/* ── CGGX Rofi — Cyberpunk Theme ───── */
/* File: ~/.config/rofi/config.rasi       */
/* Design: bold red frame, full red       */
/* selection highlight, category-colored  */
/* entries via custom launcher script.    */

/* ── Palette ──────────────────────────── */
* {
  bg:      #0a0a0c;
  bg-alt:  #111115;
  surface: #1a1a20;
  border:  #2a2a35;
  fg:      #e8e8f0;
  fg-dim:  #6a6a80;
  red:     #ff2d55;
  cyan:    #00e5ff;
  lime:    #c8ff00;
  orange:  #ff6b00;
  purple:  #bd00ff;
  pink:    #ff007f;
  gold:    #ffcc00;
}

/* ── Configuration ────────────────────── */
configuration {
  modes:                 [ drun, run, window ];
  terminal:              "kitty";
  show-icons:            false;    /* icons are Nerd Font glyphs in markup */
  drun-display-format:   "{name}";
  sidebar-mode:          false;
  click-to-exit:         true;
  cycle:                 true;
  matching:              "normal";
  sort:                  false;
  case-sensitive:        false;
}

/* ── Global widget defaults ───────────── */
* {
  background-color: transparent;
  text-color:       var(fg);
  border-color:     var(border);
  border-radius:    0;
  spacing:          0;
  padding:          0;
  margin:           0;
}

/* ── Window ───────────────────────────── */
window {
  background-color: #0a0a0c;
  text-color:       var(fg);
  border:           2px;
  border-color:     var(red);
  border-radius:    0;
  width:            520px;
  padding:          0;
  location:         center;
  anchor:           center;
  fullscreen:       false;
  transparency:     "background";
  font:             "JetBrainsMonoNL Nerd Font Mono 13";
  cursor:           "default";
}

/* ── Mainbox ──────────────────────────── */
mainbox {
  enabled:         true;
  spacing:         0;
  padding:         0;
  background-color: transparent;
}

/* ── Inputbar ─────────────────────────── */
inputbar {
  spacing:         0;
  border:          0;
}

/* ── Prompt (hidden) ──────────────────── */
prompt {
  enabled:      false;
}

/* ── Entry (search box) ───────────────── */
entry {
  enabled:             true;
  background-color:    transparent;
  text-color:          var(fg);
  placeholder-color:   var(fg-dim);
  placeholder:         "search...";
  cursor-color:        var(red);
  cursor-width:        2px;
  hide-cursor-on-empty: false;
  padding:             12px 14px;
  font:                "JetBrainsMonoNL Nerd Font Mono 13";
}

/* ── Case indicator ───────────────────── */
case-indicator {
  enabled:    false;
}

/* ── Listview ─────────────────────────── */
listview {
  columns:        1;
  lines:          12;
  spacing:        0;
  dynamic:        false;
  cycle:          true;
  scrollbar:      false;
  fixed-height:   false;
  reverse:        false;
  padding:        0 0 6px;
  layout:         vertical;
  cursor:         "default";
}

/* ── Element (each row) ───────────────── */
element {
  orientation: horizontal;
  children:    [ element-text ];
  spacing:     0;
  padding:     6px 14px;
  cursor:      "default";
}

/* Element states ───────────────────────── */
/* With -markup-rows, Pango foreground takes */
/* precedence. Category-colored text shows   */
/* on the grey selection background.         */
element normal.normal {
  background-color: transparent;
  text-color:       inherit;
}
element normal.urgent {
  background-color: transparent;
  text-color:       var(orange);
}
element normal.active {
  background-color: transparent;
  text-color:       var(cyan);
}
element selected.normal {
  background-color: #2a2a35;
}
element selected.urgent {
  background-color: #2a2a35;
}
element selected.active {
  background-color: #2a2a35;
}
element alternate.normal {
  background-color: rgba(255, 255, 255, 0.03);
  text-color:       inherit;
}

/* ── Element text ─────────────────────── */
element-text {
  text-color:       inherit;
  vertical-align:  0.5;
  horizontal-align: 0;
  cursor:           "default";
  highlight:        bold;
  font:             "JetBrainsMonoNL Nerd Font Mono 13";
}

/* ── Mode switcher (hidden) ───────────── */
mode-switcher {
  enabled:         false;
}

/* ── Message box ──────────────────────── */
message {
  background-color: var(bg-alt);
  border-top:      1px;
  border-color:     var(border);
  padding:         8px 12px;
}
textbox {
  text-color: var(fg-dim);
}
