# ── CGGX Swappy ──────────────────────────────────────
# Place at: ~/.config/swappy/config
# Swappy is a screenshot editing tool (grimblast → swappy pipeline)

[Default]
save_dir=$HOME/Pictures/Screenshots
save_filename_format=%Y-%m-%d_%H-%M-%S.png
show_panel=false
line_size=3
text_size=20
text_font=JetBrainsMono Nerd Font
paint_mode=brush
early_exit=true
fill_shape=false
