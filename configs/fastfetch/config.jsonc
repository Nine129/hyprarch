{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/home/nine/.config/fastfetch/logo.txt",
    "type": "file",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  →  "
  },
  "modules": [
    { "type": "title", "outputColor": "cyan" },
    "separator",

    // ── System ──
    { "type": "os",      "key": "OS",       "keyColor": "red" },
    { "type": "kernel",  "key": "Kernel",   "keyColor": "red" },
    { "type": "uptime",  "key": "Uptime",   "keyColor": "red" },

    // ── Software ──
    { "type": "packages","key": "Packages", "keyColor": "bright_green" },
    { "type": "shell",   "user":"shell",    "keyColor": "bright_green" },
    { "type": "wm",      "key": "WM",       "keyColor": "bright_green" },
    { "type": "terminal","key": "Terminal", "keyColor": "bright_green" },

    // ── Hardware ──
    { "type": "cpu",     "key": "CPU",     "keyColor": "magenta" },
    { "type": "gpu",     "key": "GPU",     "keyColor": "magenta" },
    { "type": "memory",  "key": "Memory",  "keyColor": "magenta" },
    { "type": "disk",    "key": "Disk",    "keyColor": "magenta" },
    { "type": "battery", "key": "Battery", "keyColor": "magenta" },

    "separator",
    { "type": "colors", "symbol": "circle" }
  ]
}
