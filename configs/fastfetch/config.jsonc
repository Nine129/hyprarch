{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "/home/nine/hyprarch/configs/fastfetch/xnewlogo.png",
    "type": "kitty",
    "width": 33,
    "preserveAspectRatio": true,
    "padding": { "right": 6 }
  },

  "logoColors": [
    "#E0A500",
    "#E0A500",
    "#E0A500",
    "#0a0a0c",
    "#1a1a20",
    "#6a6a80",
    "#ff6b00",
    "#e8e8f0",
    "#2a2a35"
  ],

  "display": {
    "key": { "width": 10 },
    "separator": " ",
    "color": { "keys": "#e8e8f0" },
    "percent": {
      "color": {
        "green": "#ff6b00",
        "yellow": "#ff6b00",
        "red": "#ff6b00",
    "maxTerminalWidth": 0
      }
    }
  },

  "modules": [
    "break",

    { "type": "command", "key": "  USER", "keyColor": "bold_#ff2d55", "outputColor": "#e8e8f0", "text": "echo $(whoami)@$(hostnamectl hostname)" },

    { "type": "os",      "key": "  OS",     "keyColor": "bold_#ff2d55" },
    { "type": "kernel",  "key": "  KER",    "keyColor": "bold_#ff2d55" },
    { "type": "uptime",  "key": "󰥔  UP",     "keyColor": "bold_#ff2d55" },

    "break",

    { "type": "packages","key": "󰏗  PKGS",   "keyColor": "bold_#c8ff00" },
    { "type": "shell",   "key": "󰆍  SH",     "keyColor": "bold_#c8ff00" },
    { "type": "wm",      "key": "  WM",     "keyColor": "bold_#c8ff00" },
    { "type": "terminal","key": "  TERM",   "keyColor": "bold_#c8ff00" },

    "break",

    { "type": "cpu",     "key": "󰻠  CPU",   "keyColor": "bold_#00e5ff" },
    { "type": "gpu",     "key": "󰢮  GPU",   "keyColor": "bold_#00e5ff" },
    { "type": "memory",  "key": "󰍛  RAM",   "keyColor": "bold_#00e5ff" },
    { "type": "disk",    "key": "󰋊  SSD",   "keyColor": "bold_#00e5ff" },
    { "type": "battery", "key": "󰂄  BAT",   "keyColor": "bold_#00e5ff" },

    "break",
    "break"
  ]
}
