# ~/.config/zathura/zathurarc

# --- Behavior ---
set adjust-open             "width"
set scroll-step             100
set scroll-full-overlap     0.1
set scroll-page-aware       true
set pages-per-row           1
set scroll-wrap             false
set zoom-step               10
set zoom-center             true
set selection-clipboard     clipboard
set incremental-search      true
set window-title-basename   true
set window-title-page       true
set render-loading          false

set guioptions             s,o    # statusbar, first-page-only scrollbar
# --- Recolor (invert PDFs to dark) ---
set recolor                 true
set recolor-keephue         true
set recolor-lightcolor      "#151518"
set recolor-darkcolor       "#e0e0e0"
set recolor-reverse-video   true

# --- CGGX theme ---
set default-bg              "#151518"
set default-fg              "#e0e0e0"

set statusbar-bg            "#111114"
set statusbar-fg            "#00e5ff"

set inputbar-bg             "#111114"
set inputbar-fg             "#e0e0e0"

set highlight-color         "#ff6b00"
set highlight-active-color  "#ff2d55"

set completion-bg           "#111114"
set completion-fg           "#e0e0e0"
set completion-highlight-bg "#ff2d55"
set completion-highlight-fg "#0a0a0c"

set notification-bg         "#111114"
set notification-fg         "#c8ff00"
set notification-error-bg   "#ff2d55"
set notification-error-fg   "#0a0a0c"
set notification-warning-bg "#ff6b00"
set notification-warning-fg "#151518"
set font                    "MonaspiceNe Nerd Font 11"

set statusbar              "   Pg %{current_page} / %{total_pages}   %{title}  "
set selection-style         "solid"
# --- Keybinds ---
map [normal] K              zoom in
map [normal] J              zoom out
map [normal] <C-r>          recolor
map [normal] <Tab>          toggle_index
map [normal] <S-Tab>        toggle_inputbar
map [normal] <C-j>          scroll downward
map [normal] <C-k>          scroll upward
map [normal] <C-d>          scroll halfpage downward
map [normal] <C-u>          scroll halfpage upward
map [normal] r              reload
map [normal] <C-n>          navigate next
map [normal] <C-p>          navigate previous
map [normal] <C-=>          zoom in
map [normal] <C-->          zoom out
map [normal] p              print
map [fullscreen] f          toggle_fullscreen
map [normal] f              toggle_fullscreen
