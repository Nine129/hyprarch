# ── CGGX Yazi Theme ────────────────────────────────────
# Place at: ~/.config/yazi/theme.toml
# https://github.com/sxyazi/yazi
#
# Palette: CGGX kinetic brutalist
#   Base    #0a0a0c  ·  Surface  #1a1a20  ·  Border  #2a2a35
#   Red     #ff2d55  ·  Cyan     #00e5ff  ·  Lime    #c8ff00
#   Orange  #ff6b00  ·  Purple   #bd00ff  ·  Lavender #b48cff
#   Silver  #e8e8f0  ·  Muted    #6a6a80

# ── File-type colors ───────────────────────────────────
[filetype]
rules = [
  # Source code — amber (before directory catch-all)
  { url = "*.rs",     fg = "#E0A500" },
  { url = "*.py",     fg = "#E0A500" },
  { url = "*.js",     fg = "#E0A500" },
  { url = "*.ts",     fg = "#E0A500" },
  { url = "*.go",     fg = "#E0A500" },
  { url = "*.c",      fg = "#E0A500" },
  { url = "*.h",      fg = "#E0A500" },
  { url = "*.cpp",    fg = "#E0A500" },
  { url = "*.hpp",    fg = "#E0A500" },
  { url = "*.zig",    fg = "#E0A500" },
  { url = "*.vue",    fg = "#E0A500" },
  { url = "*.svelte", fg = "#E0A500" },

  # Directories — lime
  { url = "*", type = "directory", fg = "#c8ff00" },

  # Images — hot purple
  { url = "*.png",  fg = "#bd00ff" },
  { url = "*.jpg",  fg = "#bd00ff" },
  { url = "*.jpeg", fg = "#bd00ff" },
  { url = "*.gif",  fg = "#bd00ff" },
  { url = "*.webp", fg = "#bd00ff" },
  { url = "*.svg",  fg = "#bd00ff" },
  { url = "*.ico",  fg = "#bd00ff" },
  { url = "*.bmp",  fg = "#bd00ff" },

  # Video — hot purple
  { url = "*.mp4",  fg = "#bd00ff" },
  { url = "*.mov",  fg = "#bd00ff" },
  { url = "*.mkv",  fg = "#bd00ff" },
  { url = "*.avi",  fg = "#bd00ff" },
  { url = "*.webm", fg = "#bd00ff" },
  { url = "*.flv",  fg = "#bd00ff" },

  # Audio — red
  { url = "*.mp3",  fg = "#ff2d55" },
  { url = "*.flac", fg = "#ff2d55" },
  { url = "*.wav",  fg = "#ff2d55" },
  { url = "*.aac",  fg = "#ff2d55" },
  { url = "*.ogg",  fg = "#ff2d55" },
  { url = "*.opus", fg = "#ff2d55" },
  { url = "*.m4a",  fg = "#ff2d55" },

  # Archives / compressed — cyan
  { url = "*.zip",   fg = "#00e5ff" },
  { url = "*.tar",   fg = "#00e5ff" },
  { url = "*.gz",    fg = "#00e5ff" },
  { url = "*.xz",    fg = "#00e5ff" },
  { url = "*.bz2",   fg = "#00e5ff" },
  { url = "*.7z",    fg = "#00e5ff" },
  { url = "*.rar",   fg = "#00e5ff" },
  { url = "*.zst",   fg = "#00e5ff" },
  { url = "*.iso",   fg = "#00e5ff" },
  { url = "*.deb",   fg = "#00e5ff" },
  { url = "*.rpm",   fg = "#00e5ff" },

  # Config / markup — orange
  { url = "*.lua",   fg = "#ff6b00" },
  { url = "*.conf",  fg = "#ff6b00" },
  { url = "*.json",  fg = "#ff6b00" },
  { url = "*.toml",  fg = "#ff6b00" },
  { url = "*.yaml",  fg = "#ff6b00" },
  { url = "*.yml",   fg = "#ff6b00" },
  { url = "*.ini",   fg = "#ff6b00" },
  { url = "*.css",   fg = "#ff6b00" },
  { url = "*.html",  fg = "#ff6b00" },
  { url = "*.xml",   fg = "#ff6b00" },
  { url = "*.nix",   fg = "#ff6b00" },
  { url = "*.env",   fg = "#ff6b00" },
  { url = "*.cfg",   fg = "#ff6b00" },

  # Shell scripts / misc code — lavender
  { url = "*.sh",    fg = "#b48cff" },
  { url = "*.bash",  fg = "#b48cff" },
  { url = "*.zsh",   fg = "#b48cff" },
  { url = "*.fish",  fg = "#b48cff" },
  { url = "*.java",  fg = "#b48cff" },
  { url = "*.kt",    fg = "#b48cff" },
  { url = "*.rb",    fg = "#b48cff" },
  { url = "*.php",   fg = "#b48cff" },
  { url = "*.hs",    fg = "#b48cff" },
  { url = "*.pl",    fg = "#b48cff" },
  { url = "*.cs",    fg = "#b48cff" },
  { url = "*.swift", fg = "#b48cff" },

  # Documents — silver
  { url = "*.md",    fg = "#e8e8f0" },
  { url = "*.txt",   fg = "#e8e8f0" },
  { url = "*.pdf",   fg = "#e8e8f0" },
  { url = "*.doc",   fg = "#e8e8f0" },
  { url = "*.docx",  fg = "#e8e8f0" },
  { url = "*.rtf",   fg = "#e8e8f0" },

  # Fonts — silver
  { url = "*.ttf",   fg = "#e8e8f0" },
  { url = "*.otf",   fg = "#e8e8f0" },
  { url = "*.woff",  fg = "#e8e8f0" },
  { url = "*.woff2", fg = "#e8e8f0" },

  # Logs / binary / database — muted
  { url = "*.log",    fg = "#6a6a80" },
  { url = "*.bin",    fg = "#6a6a80" },
  { url = "*.dat",    fg = "#6a6a80" },
  { url = "*.db",     fg = "#6a6a80" },
  { url = "*.sqlite", fg = "#6a6a80" },
  { url = "*.lock",   fg = "#6a6a80" },

  # Executables — cyan
  { url = "*", type = "executable", fg = "#00e5ff" },

  # Symlinks — red
  { url = "*", type = "symlink", fg = "#ff2d55" },

  # Special files
  { url = "Makefile",     fg = "#ff6b00" },
  { url = "Dockerfile",   fg = "#ff6b00" },
  { url = ".gitignore",   fg = "#ff2d55" },
  { url = ".gitconfig",   fg = "#ff2d55" },
  { url = ".editorconfig", fg = "#ff6b00" },
]

# ── File-type icons (Nerd Font) ────────────────────────
[icon]
rules = [
  # Directories
  { url = "*", type = "directory", name = " " },

  # Images
  { url = "*.png",  name = " " },
  { url = "*.jpg",  name = " " },
  { url = "*.jpeg", name = " " },
  { url = "*.gif",  name = " " },
  { url = "*.webp", name = " " },
  { url = "*.svg",  name = " " },
  { url = "*.ico",  name = " " },
  { url = "*.bmp",  name = " " },

  # Video
  { url = "*.mp4",  name = "󰕼 " },
  { url = "*.mov",  name = "󰕼 " },
  { url = "*.mkv",  name = "󰕼 " },
  { url = "*.avi",  name = "󰕼 " },
  { url = "*.webm", name = "󰕼 " },

  # Audio
  { url = "*.mp3",  name = " " },
  { url = "*.flac", name = " " },
  { url = "*.wav",  name = " " },
  { url = "*.ogg",  name = " " },
  { url = "*.m4a",  name = " " },

  # Archives
  { url = "*.zip",  name = " " },
  { url = "*.tar",  name = " " },
  { url = "*.gz",   name = " " },
  { url = "*.7z",   name = " " },
  { url = "*.rar",  name = " " },
  { url = "*.zst",  name = " " },
  { url = "*.iso",  name = " " },
  { url = "*.deb",  name = " " },

  # Config
  { url = "*.toml", name = " " },
  { url = "*.json", name = " " },
  { url = "*.yaml", name = " " },
  { url = "*.yml",  name = " " },
  { url = "*.conf", name = " " },
  { url = "*.ini",  name = " " },
  { url = "*.env",  name = " " },

  # Source code
  { url = "*.rs",    name = " " },
  { url = "*.py",    name = " " },
  { url = "*.js",    name = " " },
  { url = "*.ts",    name = " " },
  { url = "*.go",    name = " " },
  { url = "*.c",     name = " " },
  { url = "*.cpp",   name = " " },
  { url = "*.zig",   name = " " },
  { url = "*.vue",   name = " " },
  { url = "*.svelte", name = " " },

  # Shell scripts
  { url = "*.sh",   name = " " },
  { url = "*.bash", name = " " },
  { url = "*.zsh",  name = " " },
  { url = "*.fish", name = " " },

  # Documents
  { url = "*.md",   name = " " },
  { url = "*.txt",  name = " " },
  { url = "*.pdf",  name = " " },

  # Fonts
  { url = "*.ttf",  name = " " },
  { url = "*.otf",  name = " " },

  # Logs / binary
  { url = "*.log",  name = " " },
  { url = "*.lock", name = " " },

  # Special files
  { url = "Makefile",    name = " " },
  { url = "Dockerfile",  name = " " },
  { url = ".gitignore",  name = " " },

  # Executables
  { url = "*", type = "executable", name = " " },

  # Symlinks
  { url = "*", type = "symlink", name = " " },
]

# ── Manager ────────────────────────────────────────────
[mgr]
syntect_theme = ""
border_symbol = "│"
border_style = { fg = "#2a2a35" }

[mgr.cwd]
fg = "#e8e8f0"

[mgr.find_keyword]
fg = "#ff2d55"

[mgr.find_position]
fg = "#ff6b00"

[mgr.symlink_target]
fg = "#6a6a80"

[mgr.marker_selected]
fg = "#ff2d55"

[mgr.marker_copied]
fg = "#c8ff00"

[mgr.marker_cut]
fg = "#ff2d55"

[mgr.marker_marked]
fg = "#bd00ff"

[mgr.count_selected]
fg = "#ff2d55"

[mgr.count_copied]
fg = "#c8ff00"

[mgr.count_cut]
fg = "#ff2d55"

[mgr.preview]
selected = { fg = "#e8e8f0", bg = "#1a1a20" }

# ── Indicator bars ─────────────────────────────────────
[indicator]
parent = { fg = "#6a6a80" }
current = { fg = "#ff2d55" }
preview = { fg = "#2a2a35" }
padding = { open = "▌", close = "▐" }

# ── Tabs ───────────────────────────────────────────────
[tabs]
active = { fg = "#e8e8f0", bg = "#1a1a20" }
inactive = { fg = "#6a6a80", bg = "#0a0a0c" }
sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

# ── Mode indicators ────────────────────────────────────
[mode]
normal_main = { fg = "#0a0a0c", bg = "#ff2d55" }
normal_alt = { fg = "#e8e8f0", bg = "#1a1a20" }
select_main = { fg = "#0a0a0c", bg = "#c8ff00" }
select_alt = { fg = "#e8e8f0", bg = "#1a1a20" }
unset_main = { fg = "#0a0a0c", bg = "#6a6a80" }
unset_alt = { fg = "#e8e8f0", bg = "#1a1a20" }

# ── Status bar — HUD ──────────────────────────────────
[status]
overall = { fg = "#e8e8f0", bg = "#1a1a20" }
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }

[status.perm_type]
fg = "#ff2d55"

[status.perm_read]
fg = "#e8e8f0"

[status.perm_write]
fg = "#ff6b00"

[status.perm_exec]
fg = "#c8ff00"

[status.perm_sep]
fg = "#6a6a80"

[status.progress_label]
fg = "#e8e8f0"

[status.progress_normal]
fg = "#ff2d55"

[status.progress_error]
fg = "#ff2d55"

# ── Which (key hints) ─────────────────────────────────
[which]
cols = 3
mask = { fg = "#6a6a80", bg = "#1a1a20" }
cand = { fg = "#ff2d55" }
rest = { fg = "#e8e8f0" }
desc = { fg = "#6a6a80" }
separator = " → "
separator_style = { fg = "#6a6a80" }

# ── Confirm dialog ─────────────────────────────────────
[confirm]
border = { fg = "#ff2d55" }
title = { fg = "#e8e8f0" }
body = { fg = "#6a6a80" }
list = { fg = "#e8e8f0" }
btn_yes = { fg = "#0a0a0c", bg = "#ff2d55" }
btn_no = { fg = "#e8e8f0", bg = "#1a1a20" }
btn_labels = [">> Yes", "No"]

# ── Spot (file details) ────────────────────────────────
[spot]
border = { fg = "#2a2a35" }
title = { fg = "#e8e8f0" }
tbl_col = { fg = "#ff2d55" }
tbl_cell = { fg = "#e8e8f0" }

# ── Notifications ──────────────────────────────────────
[notify]
success = { fg = "#c8ff00" }
error = { fg = "#ff2d55" }
warn = { fg = "#ff6b00" }
info = { fg = "#00e5ff" }

# ── Git status signs ───────────────────────────────────
[git]
modified_sign  = "M"
modified       = { fg = "#c8ff00" }

added_sign     = "+"
added          = { fg = "#00e5ff" }

deleted_sign   = "✗"
deleted        = { fg = "#ff2d55", bold = true }

ignored_sign   = "!"
ignored        = { fg = "#6a6a80" }

clean_sign     = ""
untracked_sign = ""
unknown_sign   = ""                      
