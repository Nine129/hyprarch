# ── CGGX Hyprpaper Service ──────────────────────────────
# Place at: ~/.config/systemd/user/hyprpaper.service
# Wallpaper daemon for Hyprland
# Start: systemctl --user enable --now hyprpaper
# Logs:  journalctl --user -u hyprpaper -f

[Unit]
Description=Hyprland wallpaper daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hyprpaper
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

            