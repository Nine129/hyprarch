#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// CGGX2 — rmpc theme for the CGGX rice
// New 3-line-header layout, recolored to match the original cggx.ron scheme:
//   red #ff2d55 chrome (borders, brackets, progress, scrollbar, stickers)
//   cyan #00e5ff info (titles, separators, elapsed, dirs)
//   lime #c8ff00 active (tabs, current item, consume/single on)
//   orange #ff6b00 warm (artist, volume, random/repeat on, warns)
//   silver #e8e8f0 text · muted #6a6a80 · track #2a2a35 · purple #b48cff trace
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    multiple_tag_resolution_strategy: All,
    browser_column_widths: [20, 38, 42],
    background_color: "#151518",
    modal_backdrop: true,
    text_color: "#e8e8f0",
    header_background_color: "#151518",
    modal_background_color: "#151518",
    preview_label_style: (fg: "#ff6b00"),
    preview_metadata_group_style: (fg: "#00e5ff"),
    song_table_album_separator: None,
    tab_bar: (
        active_style: (fg: "#c8ff00", bg: "#151518", modifiers: "Bold"),
        inactive_style: (fg: "#6a6a80", bg: "#151518"),
    ),
    highlighted_item_style: (fg: "#ff2d55", modifiers: "Bold"),
    current_item_style: (fg: "#c8ff00", modifiers: "Bold"),
    borders_style: (fg: "#ff2d55"),
    highlight_border_style: (fg: "#2a2a35"),
    symbols: (song: "󰝚 ", dir: "󱍙 ", playlist: "󰲸 ", marker: "* ", ellipsis: "...",
        song_style: (fg: "#ff6b00"), song_highlighted_style: None, song_current_style: (fg: "#2e3440"),
        dir_style: (fg: "#00e5ff"), dir_highlighted_style: None, dir_current_style: (fg: "#2e3440"),
        playlist_style: (fg: "#c8ff00"), playlist_highlighted_style: None, playlist_current_style: (fg: "#2e3440"),
        marker_style: (fg: "#ebcb8b"), marker_highlighted_style: (fg: "#ebcb8b"), marker_current_style: (fg: "#2e3440", bg: "#ebcb8b"),
    ),
    progress_bar: (
        symbols: ["", "█", "", "█", ""],
        track_style: (fg: "#2a2a35", bg: "#151518"),
        elapsed_style: (fg: "#ff2d55", bg: "#151518"),
        thumb_style: (fg: "#ff2d55", bg: "#2a2a35"),
        use_track_when_empty: false,
    ),
    scrollbar: None,
    song_table_format: [
        (prop: (kind: Property(Artist), style: (fg: "#ff6b00"),
            default: (kind: Text("Unknown Artist"), style: (fg: "#6a6a80"))),
            width: "23%",
            label_prop: (kind: Group([
                (kind: Text("Artist "), style: (fg: "#e8e8f0")),
                (kind: Text(""), style: (fg: "#ff2d55"))
            ]))
        ),
        (prop: (kind: Property(Title), style: (fg: "#00e5ff"),
            default: (kind: Property(Filename), style: (fg: "#e8e8f0"),
                default: (kind: Text("Unknown Title"), style: (fg: "#e8e8f0")))),
            width: "36%",
            label_prop: (kind: Group([
                (kind: Text("Title "), style: (fg: "#e8e8f0")),
                (kind: Text(""), style: (fg: "#ff2d55"))
            ]))
        ),
        (prop: (kind: Property(Album), style: (fg: "#e8e8f0"),
            default: (kind: Text("Unknown Album"), style: (fg: "#6a6a80"))),
            width: "33%",
            label_prop: (kind: Group([
                (kind: Text("Album "), style: (fg: "#e8e8f0")),
                (kind: Text("󰀥"), style: (fg: "#ff2d55"))
            ]))
        ),
        (prop: (kind: Property(Duration), style: (fg: "#e8e8f0"),
            default: (kind: Text("-"))),
            width: "8%",
            alignment: Right,
            label_prop: (kind: Group([
                (kind: Text("Length "), style: (fg: "#e8e8f0")),
                (kind: Text(" "), style: (fg: "#ff2d55"))
            ]))
        ),
    ],
    layout: Split(direction: Vertical, panes: [
            (size: "7", borders: "NONE", pane: Component("header")),
            (size: "100%", borders: "NONE", pane: Pane(TabContent)),
            (size: "3", borders: "NONE", pane: Component("progress_bar")),
    ]),
    browser_song_format: [
        (kind: Group([
            (kind: Property(Track)),
            (kind: Text(" ")),
        ])),
        (kind: Group([
            (kind: Property(Artist)),
            (kind: Text(" - ")),
            (kind: Property(Title)),
        ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
        info:  (fg: "#c8ff00", bg: "#151518"),
        warn:  (fg: "#ff6b00", bg: "#151518"),
        error: (fg: "#ff2d55", bg: "#151518"),
        debug: (fg: "#00e5ff", bg: "#151518"),
        trace: (fg: "#b48cff", bg: "#151518"),
    ),
    components: {
        "header_tab_bar": Split(direction: Horizontal, panes: [
            (size: "11%", borders: "NONE", pane: Component("tab_bar_left")),
            (size: "78%", borders: "NONE", pane: Pane(Tabs)),
            (size: "11%", borders: "NONE", pane: Component("tab_bar_right")),
        ]),
        "header_line_1": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_1")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_2")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_3")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_2": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_4")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_5")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_6")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_3": Split(direction: Horizontal, panes: [
            (size: "25%", pane: Component("header_element_7")),
            (size: "1", pane: Component("header_element_space")),
            (size: "50%", pane: Component("header_element_8")),
            (size: "1", pane: Component("header_element_space")),
            (size: "25%", pane: Component("header_element_9")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header": Split(direction: Vertical, panes: [
            (size: "2", borders: "TOP | RIGHT | LEFT", border_symbols: Plain,
                pane: Split(direction: Horizontal, panes: [
                    (size: "100%", borders: "NONE", pane: Component("header_tab_bar")),
                ])
            ),
            (size: "5", borders: "ALL", border_symbols: Library("rounded_collapsed_top"),
                border_title: [
                    (kind: Text("─"), style: (fg: "#ff2d55")),
                ],
                border_title_position: Bottom,
                border_title_alignment: Right,
                pane: Split(direction: Vertical, panes: [
                    (size: "100%", borders: "NONE", pane: Component("header_line_1")),
                    (size: "100%", borders: "NONE", pane: Component("header_line_2")),
                    (size: "100%", borders: "NONE", pane: Component("header_line_3")),
                ])
            ),
        ]),
        "progress_bar": Split(direction: Vertical, panes: [
                (size: "3", borders: "ALL", border_symbols: Plain,
                    border_title: [
                        (kind: Property(Status(Elapsed)), style: (fg: "#e8e8f0")),
                        (kind: Property(Status(StateV2(playing_label: "─󱦟─", paused_label: "  ", stopped_label: "  "))),
                            style: (fg: "#ff2d55", modifiers: "Bold")),
                        (kind: Property(Status(Duration)), style: (fg: "#e8e8f0")),
                    ],
                    border_title_position: Top,
                    border_title_alignment: Center,
                    pane: Split(direction: Vertical, panes: [
                        (size: "100%", borders: "NONE", pane: Pane(ProgressBar)),
                    ])
                ),
        ]),
        "tab_bar_left": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Status(StateV2(playing_label: "", paused_label: "", stopped_label: ""))),
                    style: (fg: "#e8e8f0")),
                (kind: Text("  "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Song(FileExtension)), style: (fg: "#6a6a80")),
                (kind: Text(" ")),
                (kind: Property(Widget(ScanStatus)), style: (fg: "#e8e8f0", modifiers: "Bold")),
                (kind: Text(" ")),
                (kind: Property(Status(InputBuffer())), style: (fg: "#6a6a80")),
            ], align: Left))),
        ]),
        "tab_bar_right": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content: (kind: Property(Status(Partition)), style: (fg: "#6a6a80")), replacements: [
                    (match:  "default", replace: (kind: Group([(kind: Text(""))]))),
                ]))),
                (kind: Text(" ")),
                (kind: Property(Song(Channels())), style: (fg: "#6a6a80"),
                    default: (kind: Text("0"), style: (fg: "#6a6a80"))),
                (kind: Text(" 󱡫 "), style: (fg: "#6a6a80")),
                (kind: Text(" 󱡬"), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Status(Volume)), style: (fg: "#e8e8f0")),
                (kind: Text("% "), style: (fg: "#ff2d55", modifiers: "Bold"))
            ], align: Right))),
        ]),
        "header_element_1": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Status(Elapsed)), style: (fg: "#e8e8f0")),
                (kind: Text(" / "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(Duration)), style: (fg: "#e8e8f0")),
                (kind: Text(" 󱦟"), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Text(" ]"), style: (fg: "#ff2d55", modifiers: "Bold")),
            ], align: Left))),
        ]),
        "header_element_2": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Property(Song(Title)), style: (fg: "#00e5ff", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#e8e8f0", modifiers: "Bold"),
                    default: (kind: Text("Unknown Title"), style: (fg: "#e8e8f0", modifiers: "Bold"))))
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_3": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Status(RepeatV2(on_label: "", off_label: "",
                    on_style: (fg: "#e0a601", modifiers: "Bold"),
                    off_style: (fg: "#2a2a35", modifiers: "Bold"))))
                ),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(RandomV2(on_label: "", off_label: "",
                    on_style: (fg: "#ff6b00", modifiers: "Bold"),
                    off_style: (fg: "#2a2a35", modifiers: "Bold"))))
                ),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(ConsumeV2(on_label: "󰮯", off_label: "󰮯", oneshot_label: "󰮯󰇊",
                    on_style: (fg: "#c8ff00", modifiers: "Bold"),
                    off_style: (fg: "#2a2a35", modifiers: "Bold"))))
                ),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(SingleV2(on_label: "󰎤", off_label: "󰎦", oneshot_label: "󰇊", off_oneshot_label: "󱅊",
                    on_style: (fg: "#c8ff00", modifiers: "Bold"),
                    off_style: (fg: "#2a2a35", modifiers: "Bold"))))
                ),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(Crossfade)), style: (fg: "#2a2a35"),
                    default: (kind: Text("󰴽"), style: (fg: "#2a2a35"))
                ),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match:  "Normal", replace: (kind: Group([(kind: Text("N"), style: (fg: "#2a2a35", modifiers: "Bold"))]))),
                    (match:  "Insert", replace: (kind: Group([(kind: Text("I"), style: (fg: "#c8ff00", modifiers: "Bold"))]))),
                ]))),
            ], align: Right))),
        ]),
        "header_element_4": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Song(Bits())), default: (kind: Text(" "), style: (fg: "#e8e8f0")), style: (fg: "#e8e8f0")),
                (kind: Text(" bit"), style: (fg: "#00e5ff")),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(Bitrate)), default: (kind: Text(" "), style: (fg: "#e8e8f0")), style: (fg: "#e8e8f0")),
                (kind: Text(" kbps"), style: (fg: "#00e5ff")),
                (kind: Text(" ]"), style: (fg: "#ff2d55", modifiers: "Bold"))
            ], align: Left))),
        ]),
        "header_element_5": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Artist)), style: (fg: "#ff6b00"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#ff6b00"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Artist"), style: (fg: "#ff6b00"))])))]
                ))),
                (kind: Text(" - "), style: (fg: "#e8e8f0")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Album)), style: (fg: "#00e5ff"),
                        default: (kind: Text("Unknown Album"), style: (fg: "#00e5ff"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Album"), style: (fg: "#00e5ff"))])))]
                ))),
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_6": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeRemaining(separator: " "))), style: (fg: "#e8e8f0")),
                (kind: Text(" / "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeTotal(separator: " "))), style: (fg: "#e8e8f0")),
                (kind: Text(" 󱎫"), style: (fg: "#00e5ff", modifiers: "Bold")),
            ], align: Right))),
        ]),
        "header_element_7": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
            (kind: Text("[ "), style: (fg: "#ff2d55", modifiers: "Bold")),
            (kind: Property(Song(SampleRate())), default: (kind: Text(" "), style: (fg: "#e8e8f0")), style: (fg: "#e8e8f0")),
            (kind: Text(" Hz"), style: (fg: "#00e5ff")),
            (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
            (kind: Property(Song(Position)), style: (fg: "#e8e8f0"),
                default: (kind: Text("0"), style: (fg: "#e8e8f0"))),
            (kind: Text(" / "), style: (fg: "#00e5ff", modifiers: "Bold")),
            (kind: Property(Status(QueueLength())), style: (fg: "#e8e8f0")),
            (kind: Text(" 󰴍"), style: (fg: "#00e5ff", modifiers: "Bold")),
            (kind: Text(" ]"), style: (fg: "#ff2d55", modifiers: "Bold"))
            ], align: Left))),
        ]),
        "header_element_8": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("albumartist"))), style: (fg: "#6a6a80"),
                        default: (kind: Text("Unknown Albumartist"), style: (fg: "#6a6a80"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Albumartist"), style: (fg: "#6a6a80"))])))]
                ))),
                (kind: Text(" - "), style: (fg: "#6a6a80")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("composer"))), style: (fg: "#6a6a80"),
                        default: (kind: Text("Unknown Composer"), style: (fg: "#6a6a80"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Composer"), style: (fg: "#6a6a80"))])))]
                ))),
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_9": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#ff2d55", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("date"))), style: (fg: "#e8e8f0"),
                        default: (kind: Text("Unknown Date"), style: (fg: "#6a6a80"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Date"), style: (fg: "#6a6a80"))])))]
                ))),
                (kind: Text(" | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Track)), style: (fg: "#e8e8f0"),
                        default: (kind: Text("0"), style: (fg: "#6a6a80"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("0"), style: (fg: "#6a6a80"))])))]
                ))),
                (kind: Text(" / "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Disc)), style: (fg: "#e8e8f0"),
                        default: (kind: Text("0"), style: (fg: "#6a6a80"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("0"), style: (fg: "#6a6a80"))])))]
                ))),
                (kind: Text(" 󰥠 | "), style: (fg: "#00e5ff", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("genre"))), style: (fg: "#e8e8f0"),
                        default: (kind: Text("Unknown Genre"), style: (fg: "#6a6a80"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Genre"), style: (fg: "#6a6a80"))])))]
                ))),
            ], align: Right))),
        ]),
        "header_element_right_end": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" ]"), style: (fg: "#ff2d55", modifiers: "Bold")),
            ], align: Right))),
        ]),
        "header_element_space": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" ")),
            ], align: Right))),
        ]),
    },
cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 2, bar_spacing: 1,
        orientation: Bottom,
        bg_color: "#151518",
        bar_color: Gradient({
            0:   "#ffd700", // Gold
            25:  "#ff8c00", // Dark orange
            50:  "#ff4500", // Red-orange
            75:  "#e6003a", // Crimson
            100: "#8a0020", // Dark red
        })
    ),
    lyrics:(
        timestamp: false,
        alignment: Center,
    ),
    border_symbol_sets: {
        "rounded_collapsed_top": (
            parent: Plain,
            top_left: "├",
            top_right: "┤",
        ),
    },
)
