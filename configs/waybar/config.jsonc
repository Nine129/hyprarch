// ── CGGX Waybar — Bar Layout ───────────
// Module defs in: ~/.config/waybar/modules/cggx.jsonc
[
  {
    "layer":    "top",
    "position": "top",
    "height":   70,

    "include": "~/.config/waybar/modules/cggx.jsonc",

    "modules-left": [
      "hyprland/workspaces#number"
    ],

    "modules-center": [],

    "modules-right": [
      // Group 1: System
      "disk",
      "memory",
      "network",
      "custom/sep1",
      // Group 2: Personal UI
      "pulseaudio",
      "clock",
      "battery",
      "custom/sep2",
      // Group 3: Utilities
      "tray",
      "custom/power-button"
    ],
  }
]
